rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          "romitoorazio@gmail.com",
          "romitofrancesco1@gmail.com"
        ];
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Qui salviamo dati riservati admin, come i link iCal Booking/Airbnb.
    // Non devono essere leggibili pubblicamente dal sito.
    match /privateSettings/{document=**} {
      allow read, write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read, write: if isAdmin();
    }

    match /nights/{nightId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Log operativi del PMS: attività admin, sync calendari, registro interno.
    match /maintenanceLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Dati tecnici usati dalle API server per protezione/rate-limit/debug pagamenti.
    match /bookingRateLimits/{document=**} {
      allow read, write: if isAdmin();
    }

    match /stripeEvents/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
