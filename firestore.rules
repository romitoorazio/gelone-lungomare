rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          "romitoorazio@gmail.com",
          "romitofrancesco1@gmail.com"
        ];
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function nightHasBookingId() {
      return resource.data.bookingId is string && resource.data.bookingId.size() > 0;
    }

    function bookingAfterIsCancelledOrDeleted(bookingId) {
      return !existsAfter(bookingPath(bookingId))
        || getAfter(bookingPath(bookingId)).data.status in [
          "cancelled",
          "canceled",
          "deleted",
          "available",
          "rejected",
          "declined"
        ];
    }

    function bookingAfterNoLongerUsesNight(bookingId) {
      return existsAfter(bookingPath(bookingId))
        && getAfter(bookingPath(bookingId)).data.checkIn is string
        && getAfter(bookingPath(bookingId)).data.checkOut is string
        && resource.data.date is string
        && (
          resource.data.date < getAfter(bookingPath(bookingId)).data.checkIn
          || resource.data.date >= getAfter(bookingPath(bookingId)).data.checkOut
        );
    }

    function canSafelyDeleteNight() {
      return !nightHasBookingId()
        || bookingAfterIsCancelledOrDeleted(resource.data.bookingId)
        || bookingAfterNoLongerUsesNight(resource.data.bookingId);
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Qui salviamo dati riservati admin, come i link iCal Booking/Airbnb.
    // Non devono essere leggibili pubblicamente dal sito.
    match /privateSettings/{document=**} {
      allow read, write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read, write: if isAdmin();
    }

    match /nights/{nightId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && canSafelyDeleteNight();
    }

    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Log operativi del PMS: attività admin, sync calendari, registro interno.
    match /maintenanceLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Dati tecnici usati dalle API server per protezione/rate-limit/debug pagamenti.
    match /bookingRateLimits/{document=**} {
      allow read, write: if isAdmin();
    }

    match /stripeEvents/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
